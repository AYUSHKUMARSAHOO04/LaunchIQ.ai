# Supabase (auth + database)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI provider (OpenAI-compatible chat-completions API)
# Default provider is OpenRouter (https://openrouter.ai), which serves
# qwen/qwen3.6-27b behind an OpenAI-compatible endpoint.
VITE_AI_API_KEY=your-ai-provider-api-key
VITE_AI_MODEL=qwen/qwen3.6-27b
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
